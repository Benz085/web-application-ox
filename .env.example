# Server (Vercel Functions) — never commit real values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; "\n" in the key is handled in code
FIREBASE_PRIVATE_KEY=

# Client (Vite) — Firebase web app config, public by design
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Test only: swaps Firebase auth for a fake user. NEVER set in production.
# VITE_E2E=true
